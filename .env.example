# Copy to .env, then fill in the blanks Ionel sends you and your own Anthropic key.
# The README's .env table says what each setting does. A blank value means the default.
# Quote a value that holds a space: uv, which runs some make targets, otherwise drops the file.

# The AECA inbox and its OAuth client. Ionel sends the client id, the secret and the token.
GMAIL_ADDRESS=aecatest74@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Your own key.
ANTHROPIC_API_KEY=

# Blank: the AECA account itself.
MANAGER_ADDRESS=
# Blank: every urgent sender counts as internal.
INTERNAL_SENDERS=
BULK_SENDERS=
# Blank: the calendar's own time zone.
TIMEZONE=
WORK_HOURS="Mon-Fri 09:00-17:00"
MEETING_MINUTES=30
BUFFER_MINUTES=10
ALTERNATIVE_DAYS=5
POLL_SECONDS=30
SALES_DECLINE_NEEDS_APPROVAL=false
MAX_USD_PER_DAY=5
ALERT_AFTER_FAILURES=3
DEBUG_LOG=false
DEBUG_LOG_DAYS=7
EXTRA_CA_CERTS=
FORCE_LOCK=false

# Only for make rehearse, Ionel's rehearsal.
REHEARSAL_INTERNAL_SENDER=
REHEARSAL_EXTERNAL_SENDER=
